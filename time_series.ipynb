      "source": [
        "from statsforecast.models import AutoARIMA\n",
        "unique_ids=['BAGUETTE','CROISSANT']\n",
        "s_train=train[train['unique_id'].isin(unique_ids)]\n",
        "s_test=test[test['unique_id'].isin(unique_ids)]\n",
        "models=[\n",
        "    AutoARIMA(seasonal=False,alias='ARIMA'),\n",
        "    AutoARIMA(season_length=7,alias='SARIMA')\n",
        "]\n",
        "sf=StatsForecast(models=models,freq=\"D\")\n",
        "sf.fit(df=s_train)\n",
        "pred=sf.predict(h=horizon)\n",
        "arima_eval_df=pd.merge(s_test,pred,'left',[\"ds\",\"unique_id\"])\n",
        "arima_eval=evaluate(arima_eval_df,metrics=[mae])\n"
      ]
    },
